# Power BI Migration Optimizer – Environment Variables
# Copy this file to .env and fill in your values

# API key required on every /api call (X-API-Key header). The app will not start
# without it, except via `python app.py` on localhost. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPTIMIZER_API_KEY=

# Azure AD / Power BI Service Principal
PBI_TENANT_ID=your-tenant-id-here
PBI_CLIENT_ID=your-app-client-id-here
PBI_CLIENT_SECRET=your-app-secret-here
